    {
      "name": "08 Apply with PDF",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/jobs/{{jobId}}/applications",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{candidateToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "resume",
              "type": "file",
              "src": "sample-resume.pdf"
            },
            {
              "key": "coverLetter",
              "type": "text",
              "value": "I enjoy building thoughtful, accessible products."
            }
          ]
        },
        "description": "Select project 2/postman/sample-resume.pdf in Body > form-data > resume. Leave Content-Type automatic; Postman adds the multipart boundary."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
