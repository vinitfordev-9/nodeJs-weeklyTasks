{
  "info": {
    "name": "Project 2 - Role & Co Job Board",
    "description": "Run in order. Registers a company and candidate, captures tokens and IDs, publishes and applies, tests permissions, then deletes the test job. Select the supplied PDF for requests 08 and 09. Uses localhost:3002.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3002"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "companyToken",
      "value": ""
    },
    {
      "key": "candidateToken",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Response code', () => pm.expect(body.code).to.eql('SERVICE_HEALTHY'));",
              "pm.test('Consistent envelope', () => pm.expect(body).to.have.all.keys('success','code','message','data','errors','meta'));",
              "pm.test('Success flag', () => pm.expect(body.success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register company",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Recruiter\",\n  \"email\": \"company-{{runId}}@example.test\",\n  \"password\": \"PostmanPass123!\",\n  \"role\": \"company\",\n  \"companyName\": \"Postman Studio\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now() + '-' + Math.floor(Math.random() * 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response code', () => pm.expect(body.code).to.eql('ACCOUNT_CREATED'));",
              "pm.test('Consistent envelope', () => pm.expect(body).to.have.all.keys('success','code','message','data','errors','meta'));",
              "pm.test('Success flag', () => pm.expect(body.success).to.eql(true));",
              "if (pm.response.code === 201) pm.collectionVariables.set('companyToken', body.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Register candidate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Candidate\",\n  \"email\": \"candidate-{{runId}}@example.test\",\n  \"password\": \"PostmanPass123!\",\n  \"role\": \"candidate\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response code', () => pm.expect(body.code).to.eql('ACCOUNT_CREATED'));",
              "pm.test('Consistent envelope', () => pm.expect(body).to.have.all.keys('success','code','message','data','errors','meta'));",
              "pm.test('Success flag', () => pm.expect(body.success).to.eql(true));",
              "if (pm.response.code === 201) pm.collectionVariables.set('candidateToken', body.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Publish job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/jobs",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{companyToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Frontend Engineer - Postman\",\n  \"location\": \"Bengaluru, India\",\n  \"description\": \"Build accessible interfaces with a thoughtful product team. Work on meaningful problems and own your projects.\",\n  \"requirements\": \"Experience with JavaScript, React, and collaborative development.\",\n  \"tags\": [\n    \"react\",\n    \"typescript\"\n  ],\n  \"workMode\": \"hybrid\",\n  \"type\": \"full_time\",\n  \"salaryMin\": 1200000,\n  \"salaryMax\": 2000000,\n  \"currency\": \"INR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response code', () => pm.expect(body.code).to.eql('JOB_CREATED'));",
              "pm.test('Consistent envelope', () => pm.expect(body).to.have.all.keys('success','code','message','data','errors','meta'));",
              "pm.test('Success flag', () => pm.expect(body.success).to.eql(true));",
              "if (pm.response.code === 201) pm.collectionVariables.set('jobId', body.data.id);"
            ]
          }
        }
      ]
    },
