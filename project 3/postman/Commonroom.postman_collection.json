{
  "info": {
    "name": "Project 3 - Commonroom Chat",
    "description": "Run 01\u201322 in order. Saves both tokens and room/message IDs for the Socket.IO examples. Registration and test rooms remain in the local demo DB. Message retries use the same clientMessageId. See SOCKET-IO.md for live events.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3003"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "clientMessageId",
      "value": ""
    },
    {
      "key": "cursor",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Response code', () => pm.expect(result.code).to.eql('SERVICE_HEALTHY'));",
              "pm.test('Response shape', () => pm.expect(result).to.have.all.keys('success','code','message','data','errors','meta'));",
              "pm.test('Success flag', () => pm.expect(result.success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register Alex",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Alex\",\n  \"handle\": \"alex_{{runId}}\",\n  \"email\": \"alex-{{runId}}@example.test\",\n  \"password\": \"PostmanPass123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now().toString());",
              "pm.collectionVariables.set('clientMessageId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const result = pm.response.json();",
              "pm.test('Response code', () => pm.expect(result.code).to.eql('ACCOUNT_CREATED'));",
              "pm.test('Response shape', () => pm.expect(result).to.have.all.keys('success','code','message','data','errors','meta'));",
              "pm.test('Success flag', () => pm.expect(result.success).to.eql(true));",
              "if (pm.response.code === 201) pm.collectionVariables.set('tokenA', result.data.token);",
              "if (pm.response.code === 201) pm.collectionVariables.set('userA', result.data.user.id);"
            ]
          }
        }
      ]
    },
